{
  "name": "@azeajr/web-harness",
  "version": "0.1.1",
  "description": "Shared development and verification harness for offline-first Vite PWAs: agent browser sessions, one fault policy for exploration and tests, production smoke, container E2E, and CI gates.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "web-harness": "bin/web-harness.mjs"
  },
  "exports": {
    "./vite": {
      "types": "./types/vite.d.ts",
      "default": "./src/vite.mjs"
    },
    "./playwright": {
      "types": "./types/playwright.d.ts",
      "default": "./src/playwright.mjs"
    },
    "./faults": {
      "types": "./types/faults.d.ts",
      "default": "./src/faults.mjs"
    },
    "./config": {
      "types": "./types/config.d.ts",
      "default": "./src/config.mjs"
    },
    "./static-server": {
      "types": "./types/static-server.d.ts",
      "default": "./src/static-server.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "types",
    "docs"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:docker": "node --test test/docker/*.test.mjs",
    "check": "node --check bin/web-harness.mjs && for f in src/*.mjs; do node --check \"$f\" || exit 1; done && pnpm test"
  },
  "peerDependencies": {
    "playwright": ">=1.62.0",
    "vite": ">=6"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.3.4",
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
